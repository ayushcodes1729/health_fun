# Copy to .env.local for local dev. On Vercel, set every one of these in
# Project Settings -> Environment Variables. The build fails at import time if
# a NEXT_PUBLIC_* Solana variable is missing.

# --- App / Google OAuth --------------------------------------------------
# Must match the deployed origin exactly; Google rejects any redirect URI that
# is not registered, so preview deployments with random URLs will not work
# with Google Fit unless each is added in Google Cloud Console.
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# --- Solana (public; ends up in the browser bundle) ----------------------
# The public devnet RPC rate-limits browsers hard; use a Helius/QuickNode URL.
NEXT_PUBLIC_RPC_URL=https://devnet.helius-rpc.com/?api-key=YOUR_KEY
NEXT_PUBLIC_PROGRAM_ID=AurTvci86g6Wx95U93zQtonzV3CwHq7Ehpw9chS1oqCa
NEXT_PUBLIC_STAKE_MINT=66CoiGgUTe5gzb6QiD88p11irTg6ksjr1wmvsv14wbhe
NEXT_PUBLIC_STAKE_MINT_DECIMALS=6
NEXT_PUBLIC_STAKE_MINT_SYMBOL=HFT
NEXT_PUBLIC_CLUSTER=devnet

# --- Server-only secrets (never NEXT_PUBLIC_) ----------------------------
# Generated by `scripts/devnet-setup.ts` into keys/ (gitignored). Base58 or
# the JSON byte array from solana-keygen; both are accepted.
# ORACLE_SECRET_KEY signs health attestations; its pubkey must equal the
# on-chain config's verification_key.
ORACLE_SECRET_KEY=
# FAUCET_SECRET_KEY is the devnet test mint's authority and pays for minting.
# Devnet only; the faucet route refuses on mainnet.
FAUCET_SECRET_KEY=

# --- Database + sessions --------------------------------------------------
# Postgres. Locally: postgres://localhost:5432/health_fun. On Vercel use Neon's
# POOLED connection string (the -pooler host) with ?sslmode=require.
DATABASE_URL=postgres://localhost:5432/health_fun
# Signs the session cookie, which carries the user's identity. Any random
# string of 32+ characters: `openssl rand -base64 48`. Rotating it signs
# everyone out.
SESSION_SECRET=
